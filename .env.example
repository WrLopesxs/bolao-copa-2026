# Variáveis de ambiente — copie para ".env" (local) ou configure na Vercel.
# Nenhuma é obrigatória para rodar no PC: sem DATABASE_URL, usa o banco embutido.

# Banco Postgres (produção). Pegue em Neon/Supabase ou na integração da Vercel.
# Exemplo Neon: postgres://user:senha@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Segredo para assinar os logins. Use uma frase longa e aleatória.
# Se ficar vazio, é gerado e salvo no banco automaticamente.
JWT_SECRET=

# Chave da API-Football (resultados automáticos). Opcional:
# também dá para cadastrar pelo painel Admin → Configurações.
API_FOOTBALL_KEY=

# Intervalo mínimo entre sincronizações automáticas (ms). Padrão 15 min.
SYNC_INTERVAL_MS=900000

# Senha para proteger o endpoint /api/cron/sync (opcional).
CRON_SECRET=

{
  "name": "bolao-copa-2026",
  "version": "2.0.0",
  "description": "Bolão da Copa do Mundo 2026 - palpites, ranking e pontuação automática (Postgres / Vercel-ready)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "seed": "node database/seed.js",
    "dev": "node --watch --env-file-if-exists=.env backend/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.2.12"
  }
}
